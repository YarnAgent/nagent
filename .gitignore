# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.egg-info/
target/
build/
# Note: dist/ is intentionally NOT ignored — npm-from-github installs need
# the compiled output without running tsc at install time (devDeps aren't
# reliably on PATH during npm's git-dep `prepare` step).

# Logs & caches
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
