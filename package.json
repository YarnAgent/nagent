{
  "name": "nagent",
  "version": "0.1.0-alpha.1",
  "description": "Agent net — decentralized mesh CLI for cooperating agents across nodes (v0.1: single-node).",
  "type": "module",
  "bin": {
    "nagent": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/web/static && cp -R src/web/static/. dist/web/static/",
    "dev": "tsx src/cli/index.ts",
    "dev:daemon": "tsx src/cli/index.ts daemon --foreground",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^14.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
